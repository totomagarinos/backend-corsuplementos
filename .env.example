# Copy this file to `.env` and fill in the values.
# The real `.env` is gitignored and must never be committed.

# --- Django ---------------------------------------------------------------
# Generate a production key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
# True locally, False in production.
DEBUG=True

# --- Postgres -------------------------------------------------------------
# Locally these match docker-compose.yml.
# On Railway, reference the database service instead of copying values:
#   DB_HOST=${{Postgres.PGHOST}}
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Cloudinary -----------------------------------------------------------
# Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mercado Pago ---------------------------------------------------------
# Tus integraciones -> Credenciales (use the TEST credentials for a demo deploy)
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones -> Webhooks -> Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_VERIFY_SIGNATURE=True

# --- URLs -----------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8000

# --- Email ----------------------------------------------------------------
# Gmail requires an app password, not the account password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Hosts and CORS (comma separated) -------------------------------------
# Production example: your-domain.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Production example: https://your-frontend.pages.dev
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Django admin POSTs. Must include the scheme.
CSRF_TRUSTED_ORIGINS=

# --- HTTPS flags ----------------------------------------------------------
# Keep them False locally: localhost has no HTTPS.
# Set them True in production, except SECURE_SSL_REDIRECT when the platform
# terminates TLS at its edge (Railway does): a redirect can break health checks.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
